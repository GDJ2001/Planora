[Unit]
Description=Planora isolated block profiling worker
After=local-fs.target

[Service]
Type=simple
User=planora
Group=planora-users
ExecStart=/usr/libexec/planora/planora-disk-profile --serve
Restart=on-failure
RuntimeDirectory=planora
RuntimeDirectoryMode=0755
UMask=0077
AmbientCapabilities=CAP_BPF CAP_PERFMON
CapabilityBoundingSet=CAP_BPF CAP_PERFMON
LimitMEMLOCK=134217728
MemoryMax=268435456
TasksMax=16
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
