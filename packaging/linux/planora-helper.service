[Unit]
Description=Planora local hardware helper
After=local-fs.target

[Service]
Type=simple
User=planora
Group=planora-users
ExecStart=/usr/libexec/planora/planora-helper
Restart=on-failure
RuntimeDirectory=planora
RuntimeDirectoryMode=0755
UMask=0007
AmbientCapabilities=CAP_PERFMON
CapabilityBoundingSet=CAP_PERFMON
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
