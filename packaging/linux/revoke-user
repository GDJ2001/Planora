#!/bin/sh
set -eu
if [ "$(id -u)" -ne 0 ]; then
  exec pkexec /usr/libexec/planora/revoke-user
fi
case "${PKEXEC_UID:-}" in
  ''|0|0*|*[!0-9]*) echo 'Run from a local user session through pkexec.' >&2; exit 1 ;;
esac
rm -f -- "/var/lib/planora/authorized-uids/$PKEXEC_UID"
echo 'Planora authorization revoked for this account.'
