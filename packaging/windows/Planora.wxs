<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Planora" Manufacturer="Planora" Version="$(var.PlanoraVersion)" UpgradeCode="D8D1E733-9195-4B0D-9B9C-23E1B455D8D8" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer Planora version is already installed." />
    <Property Id="PLANORA_PREVIOUS_SID">
      <RegistrySearch Id="FindPlanoraAuthorizedSid" Root="HKLM" Key="SOFTWARE\Planora" Name="AuthorizedSid" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="PLANORA_PREVIOUS_ENV">
      <RegistrySearch Id="FindPlanoraLegacyEnvironment" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\PlanoraHelper" Name="Environment" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="PLANORA_PERSISTENT_ENV">
      <RegistrySearch Id="FindPlanoraPersistedEnvironment" Root="HKLM" Key="SOFTWARE\Planora" Name="AuthorizedEnvironment" Type="raw" Bitness="always64" />
    </Property>
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="PlanoraIcon.ico" SourceFile="$(var.ProjectDir)\assets\brand\platforms\windows\planora.ico" />
    <Property Id="ARPPRODUCTICON" Value="PlanoraIcon.ico" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Planora">
        <Component Id="PlanoraApp" Guid="*" Bitness="always64">
          <File Id="PlanoraExe" Source="$(var.SourceDir)\planora.exe" KeyPath="yes" />
        </Component>
        <Component Id="PlanoraShortcut" Guid="*" Bitness="always64">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Planora" Target="[INSTALLFOLDER]planora.exe" Icon="PlanoraIcon.ico" WorkingDirectory="INSTALLFOLDER" />
          <Shortcut Id="UninstallShortcut" Directory="ProgramMenuFolder" Name="Uninstall Planora" Target="[SystemFolder]WindowsPowerShell\v1.0\powershell.exe" Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]Uninstall-Planora.ps1&quot;" Icon="PlanoraIcon.ico" WorkingDirectory="INSTALLFOLDER" />
          <RegistryValue Root="HKCU" Key="Software\Planora" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
        <Component Id="PlanoraHelper" Guid="*" Bitness="always64">
          <File Id="PlanoraHelperExe" Source="$(var.SourceDir)\planora-helper.exe" KeyPath="yes" />
          <ServiceInstall Id="InstallHelper" Name="PlanoraHelper" DisplayName="Planora Helper" Description="Local hardware telemetry for Planora" Type="ownProcess" Start="demand" ErrorControl="normal" Account="LocalSystem" Arguments="--service" />
          <!-- An unapproved fresh install must not try to start the helper: it
               refuses to run until an administrator authorizes a local SID. -->
          <ServiceControl Id="ControlHelper" Name="PlanoraHelper" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <Component Id="StartAuthorizedHelper" Guid="*" Bitness="always64" Condition="PLANORA_PREVIOUS_SID" Transitive="yes">
          <!-- Start only on upgrades/repairs that found existing authorization.
               A first launch can authorize and start the demand-start service. -->
          <RegistryValue Root="HKLM" Key="SOFTWARE\Planora" Name="StartAuthorizedHelper" Type="integer" Value="1" KeyPath="yes" />
          <ServiceControl Id="StartHelperWhenAuthorized" Name="PlanoraHelper" Start="install" Wait="yes" />
        </Component>
        <Component Id="AuthorizationScript" Guid="*" Bitness="always64">
          <File Id="AuthorizationFile" Source="$(var.ProjectDir)\packaging\windows\Authorize-Planora.ps1" KeyPath="yes" />
        </Component>
        <Component Id="RevocationScript" Guid="*" Bitness="always64">
          <File Id="RevocationFile" Source="$(var.ProjectDir)\packaging\windows\Revoke-Planora.ps1" />
        </Component>
        <Component Id="UninstallScript" Guid="*" Bitness="always64">
          <File Id="UninstallFile" Source="$(var.ProjectDir)\packaging\windows\Uninstall-Planora.ps1" KeyPath="yes" />
        </Component>
        <Component Id="LicenseMitFile" Guid="*" Bitness="always64">
          <File Id="LicenseMit" Source="$(var.ProjectDir)\LICENSE-MIT" KeyPath="yes" />
        </Component>
        <Component Id="LicenseApacheFile" Guid="*" Bitness="always64">
          <File Id="LicenseApache" Source="$(var.ProjectDir)\LICENSE-APACHE" />
        </Component>
        <Component Id="NoticeFile" Guid="*" Bitness="always64">
          <File Id="Notice" Source="$(var.ProjectDir)\NOTICE" />
        </Component>
        <Component Id="PersistedAuthorization" Guid="*" Bitness="always64">
          <RegistryValue Root="HKLM" Key="SOFTWARE\Planora" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\Planora" Name="AuthorizedSid" Type="string" Value="[PLANORA_PREVIOUS_SID]" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\Planora" Name="AuthorizedEnvironment" Type="string" Value="[PLANORA_PREVIOUS_ENV][PLANORA_PERSISTENT_ENV]" />
          <RemoveRegistryKey Root="HKLM" Key="SOFTWARE\Planora" Action="removeOnUninstall" />
        </Component>
        <Component Id="PlanoraSensorBroker" Guid="*" Bitness="always64">
          <File Id="PlanoraSensorBrokerExe" Source="$(var.SourceDir)\planora-sensor-broker.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Core" Title="Core application" Description="Planora core application and privileged helper service" Level="1" AllowAbsent="no">
      <ComponentRef Id="PlanoraApp" />
      <ComponentRef Id="PlanoraShortcut" />
      <ComponentRef Id="PlanoraHelper" />
      <ComponentRef Id="StartAuthorizedHelper" />
      <ComponentRef Id="AuthorizationScript" />
      <ComponentRef Id="RevocationScript" />
      <ComponentRef Id="UninstallScript" />
      <ComponentRef Id="LicenseMitFile" />
      <ComponentRef Id="LicenseApacheFile" />
      <ComponentRef Id="NoticeFile" />
      <ComponentRef Id="PersistedAuthorization" />
    </Feature>
    <Feature Id="AdvancedSensors" Title="Advanced sensors" Description="Advanced hardware sensor broker for CPU package power, core temperatures, and storage health" Level="2">
      <Level Value="1" Condition="PLANORA_ADVANCED_SENSORS=1" />
      <ComponentRef Id="PlanoraSensorBroker" />
    </Feature>
  </Package>
</Wix>
