<?xml version="1.0" encoding="utf-8"?>
<!-- Planora's WiX 5 standard-bootstrapper theme. Control names and page actions follow
     the WiX 5.0.2 WixStdBA theme contract; layout and copy are Planora-specific. -->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
  <!-- ThmUtil encodes custom font colors as BGR, not RGB. -->
  <Font Id="0" Height="-14" Weight="400" Foreground="3d2114" Background="window">Segoe UI</Font>
  <Font Id="1" Height="-27" Weight="600" Foreground="5d2505">Segoe UI</Font>
  <Font Id="2" Height="-21" Weight="600" Foreground="3d2114">Segoe UI</Font>
  <Font Id="3" Height="-14" Weight="600" Foreground="5d2505">Segoe UI</Font>
  <Font Id="4" Height="-13" Weight="400" Foreground="7a6252">Segoe UI</Font>

  <Window Width="570" Height="430" HexStyle="100a0000" FontId="0" IconFile="planora.ico" Caption="Planora Setup">
    <ImageControl X="20" Y="18" Width="64" Height="64" ImageFile="logo.png" Visible="yes" />
    <Label X="96" Y="20" Width="450" Height="37" FontId="1" DisablePrefix="yes">Planora</Label>
    <Label X="97" Y="58" Width="450" Height="22" FontId="4" DisablePrefix="yes">Version [PlanoraDisplayVersion]  |  Windows x64 internal beta</Label>

    <Page Name="Loading">
      <Label X="22" Y="112" Width="525" Height="26" FontId="2" DisablePrefix="yes">Preparing Planora Setup</Label>
      <Label X="22" Y="147" Width="525" Height="40" FontId="0" DisablePrefix="yes" Name="CheckingForUpdatesLabel" Visible="no" />
    </Page>

    <Page Name="Help">
      <Label X="22" Y="112" Width="525" Height="28" FontId="2" DisablePrefix="yes">Setup help</Label>
      <Label X="22" Y="150" Width="525" Height="100" FontId="0" DisablePrefix="yes">Planora installs a desktop app and a local telemetry helper. Installation needs administrator approval. Open Planora from the Start menu after setup, then authorize monitoring for your Windows account.</Label>
      <Button Name="HelpCloseButton" X="-20" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0">
        <Text>Close</Text><CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Install">
      <Label X="22" Y="107" Width="525" Height="30" FontId="2" DisablePrefix="yes">Install Planora</Label>
      <Label X="22" Y="144" Width="525" Height="40" FontId="0" DisablePrefix="yes">See how processes use your computer's resources. Setup installs the desktop app, a local telemetry helper, and Start menu shortcuts.</Label>
      <Label X="22" Y="205" Width="525" Height="20" FontId="3" DisablePrefix="yes">INSTALL LOCATION</Label>
      <Label X="22" Y="230" Width="525" Height="25" FontId="0" DisablePrefix="yes">[PlanoraInstallLocation]</Label>
      <Label X="22" Y="264" Width="525" Height="38" FontId="4" DisablePrefix="yes">The helper is installed in an administrator-protected folder. Windows will request approval before making changes.</Label>
      <Hypertext Name="EulaHyperlink" X="22" Y="326" Width="525" Height="24" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.InstallLicenseLinkText)</Hypertext>
      <Checkbox Name="EulaAcceptCheckbox" X="22" Y="354" Width="525" Height="22" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>
      <Button Name="InstallUpdateButton" X="22" Y="-18" Width="215" Height="30" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
      <Button Name="InstallButton" X="-121" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0" ElevationShieldCondition="WixBundleAuthoredScope = 1 AND NOT WixBundleElevated">Install</Button>
      <Button Name="InstallCancelButton" X="-20" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0">
        <Text>Cancel</Text><CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Progress">
      <Label X="22" Y="112" Width="525" Height="28" FontId="2" DisablePrefix="yes">Installing Planora</Label>
      <Label X="22" Y="153" Width="525" Height="40" FontId="0" DisablePrefix="yes">Setup is updating the desktop app and local helper. This may take a moment.</Label>
      <Label X="22" Y="218" Width="74" Height="20" FontId="3" DisablePrefix="yes">PROGRESS</Label>
      <Label Name="OverallProgressPackageText" X="106" Y="218" Width="440" Height="20" FontId="0" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
      <Progressbar Name="OverallCalculatedProgressbar" X="22" Y="246" Width="525" Height="18" />
      <Button Name="ProgressCancelButton" X="-20" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0">Cancel</Button>
    </Page>

    <Page Name="Modify">
      <Label X="22" Y="112" Width="525" Height="28" FontId="2" DisablePrefix="yes">Manage Planora</Label>
      <Label X="22" Y="153" Width="525" Height="44" FontId="0" DisablePrefix="yes">Repair the installed files or uninstall the desktop app and local helper. Uninstall keeps your personal settings and recordings.</Label>
      <Label X="22" Y="212" Width="525" Height="20" FontId="3" DisablePrefix="yes">INSTALL LOCATION</Label>
      <Label X="22" Y="236" Width="525" Height="25" FontId="0" DisablePrefix="yes">[PlanoraInstallLocation]</Label>
      <Button Name="ModifyUpdateButton" X="22" Y="-18" Width="215" Height="30" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
      <Button Name="RepairButton" X="-222" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0" HideWhenDisabled="yes">Repair</Button>
      <Button Name="ReviewUninstallButton" X="-121" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0">
        <Text>Uninstall…</Text><ChangePageAction Page="ConfirmUninstall" />
      </Button>
      <Button Name="ModifyCancelButton" X="-20" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0">
        <Text>Close</Text><CloseWindowAction />
      </Button>
    </Page>

    <Page Name="ConfirmUninstall">
      <Label X="22" Y="112" Width="525" Height="30" FontId="2" DisablePrefix="yes">Uninstall Planora?</Label>
      <Label X="22" Y="153" Width="525" Height="72" FontId="0" DisablePrefix="yes">This removes the desktop app, local helper service, shortcuts, and system authorization. Your personal settings and recordings remain on this PC.</Label>
      <Label X="22" Y="253" Width="525" Height="45" FontId="4" DisablePrefix="yes">You can install Planora again later. Monitoring will require new authorization.</Label>
      <Button Name="BackFromUninstallButton" X="-222" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0">
        <Text>Back</Text><ChangePageAction Page="Modify" Cancel="yes" />
      </Button>
      <Button Name="UninstallButton" X="-121" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0">Uninstall</Button>
      <Button Name="CancelUninstallButton" X="-20" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0">
        <Text>Close</Text><CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Success">
      <Label X="22" Y="112" Width="525" Height="30" FontId="2" DisablePrefix="yes">
        <Text>Setup complete</Text>
        <Text Condition="WixBundleAction = 4">Planora uninstalled</Text>
        <Text Condition="WixBundleAction = 6">Planora is installed</Text>
        <Text Condition="WixBundleAction = 8">Planora repaired</Text>
      </Label>
      <Label X="22" Y="158" Width="525" Height="65" FontId="0" DisablePrefix="yes">
        <Text>Open Planora from the Start menu. The first launch guides you through authorization for live monitoring.</Text>
        <Text Condition="WixBundleAction = 4">The application and helper were removed. Personal settings and recordings remain available for a future install.</Text>
      </Label>
      <Label X="22" Y="253" Width="525" Height="45" FontId="4" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">Windows requires a restart to finish this change.</Label>
      <Button Name="LaunchButton" X="-121" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0" VisibleCondition="WixBundleAction = 6 AND NOT WixBundleElevated AND NOT WixStdBARestartRequired" HideWhenDisabled="yes">Launch</Button>
      <Button Name="SuccessRestartButton" X="-121" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0" HideWhenDisabled="yes">Restart</Button>
      <Button Name="SuccessCloseButton" X="-20" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0">
        <Text>Close</Text><CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Failure">
      <Label X="22" Y="112" Width="525" Height="30" FontId="2" DisablePrefix="yes">
        <Text>Setup could not finish</Text>
        <Text Condition="WixBundleAction = 4">Uninstall could not finish</Text>
        <Text Condition="WixBundleAction = 8">Repair could not finish</Text>
      </Label>
      <Label X="22" Y="151" Width="525" Height="38" FontId="0" DisablePrefix="yes">Review the error below. The setup log can help identify the failed step.</Label>
      <Hypertext Name="FailureLogFileLink" X="22" Y="201" Width="525" Height="40" FontId="0" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
      <Hypertext Name="FailureMessageText" X="22" Y="246" Width="525" Height="64" FontId="0" TabStop="yes" HideWhenDisabled="yes" />
      <Label X="22" Y="328" Width="525" Height="38" FontId="4" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">Windows requires a restart to finish rolling back this change.</Label>
      <Button Name="FailureRestartButton" X="-121" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0" HideWhenDisabled="yes">Restart</Button>
      <Button Name="FailureCloseButton" X="-20" Y="-18" Width="96" Height="30" TabStop="yes" FontId="0">
        <Text>Close</Text><CloseWindowAction />
      </Button>
    </Page>
  </Window>
</Theme>
